rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Patient accounts cannot be deleted directly from client
    }

    // 2. Elderly Profiles collection
    match /elderlyProfiles/{elderlyUserId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 3. Relationships collection (Many-to-Many Caretakers <-> Elderly)
    match /relationships/{relId} {
      allow read: if isAuthenticated() && (
        resource.data.caretakerId == request.auth.uid || 
        resource.data.elderlyUserId == request.auth.uid
      );

      // Caretaker creates relationship request
      allow create: if isAuthenticated() && 
        request.resource.data.caretakerId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Updates allowed only by connected members
      allow update: if isAuthenticated() && (
        resource.data.caretakerId == request.auth.uid || 
        resource.data.elderlyUserId == request.auth.uid
      );

      allow delete: if false; // Revocation sets status to 'revoked'
    }

    // 4. Family & Contacts Collection
    match /familyMembers/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Daily Routines Collection
    match /routines/{routineId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Health & Reminders Collection
    match /reminders/{reminderId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Memory Vault & Media Metadata
    match /memories/{memoryId} {
      allow read: if isAuthenticated() && (
        resource.data.elderlyUserId == request.auth.uid ||
        resource.data.uploadedBy == request.auth.uid
      );

      allow create: if isAuthenticated() && 
        request.resource.data.uploadedBy == request.auth.uid;

      allow update, delete: if isAuthenticated() && (
        resource.data.elderlyUserId == request.auth.uid ||
        resource.data.uploadedBy == request.auth.uid
      );
    }

    // 8. Specialist Profiles (Medical Registration, Verification & Credentials)
    match /specialistProfiles/{specialistId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(specialistId);
      allow delete: if false;
    }

    // 9. Specialist Relationships (Many-to-Many Specialists <-> Elderly Patients)
    match /specialistRelationships/{relId} {
      allow read: if isAuthenticated() && (
        resource.data.specialistId == request.auth.uid || 
        resource.data.elderlyUserId == request.auth.uid ||
        resource.data.caretakerId == request.auth.uid
      );

      // Specialist or Caretaker can initiate connection request
      allow create: if isAuthenticated() && (
        request.resource.data.specialistId == request.auth.uid ||
        request.resource.data.caretakerId == request.auth.uid
      );

      // Updates allowed only by connected members (specialist, caretaker, elderly)
      allow update: if isAuthenticated() && (
        resource.data.specialistId == request.auth.uid || 
        resource.data.elderlyUserId == request.auth.uid ||
        resource.data.caretakerId == request.auth.uid
      );

      allow delete: if false; // Revocation transitions status to 'revoked'
    }

    // 10. Prescriptions (Clinical Dosage & Medication Management)
    match /prescriptions/{prescriptionId} {
      // Verified specialists, caretakers, and elderly can read active/archived prescriptions
      allow read: if isAuthenticated();

      // Only verified specialists can create or update prescriptions directly
      allow create: if isAuthenticated() && 
        request.resource.data.prescribedBy == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.prescribedBy == request.auth.uid ||
        request.resource.data.prescribedBy == request.auth.uid
      );

      allow delete: if false; // Prescriptions are discontinued/archived, never deleted
    }

    // 11. Medication Requests (Caretaker-submitted Dosage/Symptom Change Queue)
    match /medicationRequests/{requestId} {
      allow read: if isAuthenticated();
      
      // Caretakers can submit requests
      allow create: if isAuthenticated() && 
        request.resource.data.requestedBy == request.auth.uid;

      // Specialists and caretakers can update status/notes
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // 12. Medical Audit Logs (Immutable Clinical Trail)
    match /medicalAuditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // 13. Medical Alerts (Missed Doses, Adverse Symptoms & Safety Alerts)
    match /medicalAlerts/{alertId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
